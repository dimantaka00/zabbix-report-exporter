# Production configuration. Exported as .env.example; generate .env using scripts/configure.py.
COMPOSE_PROJECT_NAME=zabbix-starter
APP_NAME=Zabbix Report Exporter
APP_ENV=production
TIMEZONE=Asia/Jakarta
HTTP_PORT=5010
POSTGRES_DB=zabbix_report
POSTGRES_USER=report
POSTGRES_PASSWORD=GENERATE_A_NEW_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://report:GENERATE_A_NEW_RANDOM_DATABASE_PASSWORD@postgres:5432/zabbix_report
REDIS_URL=redis://redis:6379/0
ZABBIX_URL=https://zabbix.example.invalid/api_jsonrpc.php
ZABBIX_API_TOKEN=REPLACE_WITH_YOUR_READ_ONLY_ZABBIX_TOKEN
ZABBIX_SECONDARY_URL=
ZABBIX_SECONDARY_API_TOKEN=
ZABBIX_SECONDARY_CA_FILE=
REPORT_STORAGE=/app/storage/reports
AUTH_ENABLED=true
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=GENERATE_A_NEW_RANDOM_ADMIN_PASSWORD
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_PROXY_HOST=nginx
GEOIP_DATABASE=/app/storage/geoip/dbip-country-lite.mmdb
