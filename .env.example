# Copy to .env and replace all placeholders. Never commit .env.
APP_NAME=Zabbix Report Exporter
APP_ENV=production
TIMEZONE=Asia/Jakarta
HTTP_PORT=8080
POSTGRES_DB=zabbix_report
POSTGRES_USER=report
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
DATABASE_URL=postgresql://report:CHANGE_ME_WITH_A_STRONG_PASSWORD@postgres:5432/zabbix_report
REDIS_URL=redis://redis:6379/0
ZABBIX_URL=https://zabbix.example.internal/api_jsonrpc.php
ZABBIX_API_TOKEN=REPLACE_WITH_READ_ONLY_ZABBIX_TOKEN
REPORT_STORAGE=/app/storage/reports
