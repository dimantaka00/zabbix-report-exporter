# Copy to .env and replace all placeholders. Never commit .env.
APP_NAME=Zabbix Report Exporter
APP_ENV=production
TIMEZONE=Asia/Jakarta
HTTP_PORT=5010
POSTGRES_DB=zabbix_report
POSTGRES_USER=report
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
DATABASE_URL=postgresql://report:CHANGE_ME_WITH_A_STRONG_PASSWORD@postgres:5432/zabbix_report
REDIS_URL=redis://redis:6379/0
ZABBIX_URL=https://zabbix.example.internal/api_jsonrpc.php
ZABBIX_API_TOKEN=REPLACE_WITH_READ_ONLY_ZABBIX_TOKEN
# Optional second source; existing reports and schedules default to Zabbix 1.
ZABBIX_SECONDARY_URL=
ZABBIX_SECONDARY_API_TOKEN=
# Optional CA bundle path inside the backend/worker container:
# ZABBIX_SECONDARY_CA_FILE=/run/zabbix-certs/zabbix-secondary-ca.pem
REPORT_STORAGE=/app/storage/reports
# First startup only: create an admin with a unique temporary password (12–128 characters).
# Keep true on the server. Explicit false temporarily disables login for local preparation.
AUTH_ENABLED=true
# The admin must change it after login. Never commit the real bootstrap password.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_TEMPORARY_PASSWORD
# Set true when the application is served through HTTPS.
AUTH_COOKIE_SECURE=false
# Only the actual peer address resolved for this Docker proxy is trusted for client IP.
AUTH_TRUSTED_PROXY_HOST=nginx
GEOIP_DATABASE=/app/storage/geoip/dbip-country-lite.mmdb
